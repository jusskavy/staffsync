{
  "name": "staffsync",
  "version": "1.0.0",
  "description": "StaffSync - Modern Human Resource Management Solution (MERN Stack)",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0"
  }
}
