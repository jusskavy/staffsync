# Copy this file to .env and fill the values
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/staffsync?retryWrites=true&w=majority

# Any long random text, used to sign login tokens (JWT)
JWT_SECRET=change_this_to_a_long_random_secret

PORT=5000
